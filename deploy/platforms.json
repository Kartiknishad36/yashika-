{
  "name": "Yashika Premium Userbot",
  "repo": "https://github.com/Kartiknishad36/yashika-",
  "start_command": "python3 main.py",
  "build_command": "pip install -r requirements.txt",
  "runtime": "python3.10+",
  "type": "worker",
  "env_required": [
    "API_ID",
    "API_HASH",
    "BOT_TOKEN",
    "OWNER_ID"
  ],
  "env_optional": [
    "STRING_SESSION",
    "LOG_GROUP_ID",
    "MONGO_URI",
    "MONGO_DB",
    "BOT_NAME",
    "OWNER_USERNAME",
    "SUPPORT_CHAT",
    "UPDATE_CHANNEL",
    "AUTO_DELETE",
    "DELETE_DELAY",
    "NUMLOOKUP_API_KEY",
    "COOKIES_PATH",
    "BASE_URL",
    "API_KEY"
  ],
  "env_defaults": {
    "BOT_NAME": "Yashika",
    "MONGO_DB": "yashika",
    "AUTO_DELETE": "true",
    "DELETE_DELAY": "1.5",
    "PREFIXES": ".!"
  },
  "platforms": [
    {
      "id": "railway",
      "name": "Railway",
      "url": "https://railway.app/new",
      "config_file": "railway.json",
      "alt_config": "railway.toml",
      "recommended": true
    },
    {
      "id": "render",
      "name": "Render",
      "url": "https://dashboard.render.com/",
      "config_file": "render.yaml",
      "service_type": "Background Worker",
      "recommended": true
    },
    {
      "id": "heroku",
      "name": "Heroku",
      "url": "https://dashboard.heroku.com/",
      "config_file": "app.json",
      "alt_config": "heroku.yml",
      "scale": "heroku ps:scale worker=1"
    },
    {
      "id": "koyeb",
      "name": "Koyeb",
      "url": "https://app.koyeb.com/deploy",
      "config_file": "koyeb.yaml",
      "recommended": true
    },
    {
      "id": "fly",
      "name": "Fly.io",
      "url": "https://fly.io/dashboard",
      "config_file": "fly.toml"
    },
    {
      "id": "docker",
      "name": "Docker / VPS",
      "url": "https://docs.docker.com/",
      "config_file": "Dockerfile",
      "alt_config": "docker-compose.yml"
    },
    {
      "id": "nixpacks",
      "name": "Nixpacks hosts",
      "url": "https://nixpacks.com/",
      "config_file": "nixpacks.toml"
    },
    {
      "id": "vercel",
      "name": "Vercel",
      "url": "https://vercel.com/new",
      "config_file": "vercel.json",
      "recommended": false,
      "note": "Serverless — not ideal for 24/7 userbot"
    },
    {
      "id": "replit",
      "name": "Replit",
      "url": "https://replit.com/",
      "config_file": ".replit",
      "recommended": false
    },
    {
      "id": "cyclic",
      "name": "Cyclic",
      "url": "https://app.cyclic.sh/",
      "recommended": false,
      "note": "Prefer always-on worker hosts"
    },
    {
      "id": "digitalocean",
      "name": "DigitalOcean App Platform",
      "url": "https://cloud.digitalocean.com/apps",
      "config_file": ".do/app.yaml"
    },
    {
      "id": "gcp",
      "name": "Google Cloud Run",
      "url": "https://console.cloud.google.com/run",
      "note": "Use min instances = 1 for always-on"
    },
    {
      "id": "aws",
      "name": "AWS EC2 / Lightsail",
      "url": "https://console.aws.amazon.com/"
    },
    {
      "id": "oracle",
      "name": "Oracle Cloud Free VPS",
      "url": "https://cloud.oracle.com/"
    }
  ]
}
